{
  "entities": {
    "Portfolio": {
      "title": "Portfolio",
      "description": "Aman Maurya portfolio data containing hero, profile, projects, gallery, education, and contact",
      "type": "object",
      "properties": {
        "hero": { "type": "object" },
        "profile": { "type": "object" },
        "contact": { "type": "object" },
        "settings": { "type": "object" },
        "expertise": { "type": "array" },
        "projects": { "type": "array" },
        "education": { "type": "array" },
        "internships": { "type": "array" },
        "awards": { "type": "array" },
        "galleryItems": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["hero", "profile", "contact", "projects"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for portfolio visitors and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "visitor"] },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Visitor contact enquiry or CAD project request",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "projectType": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/portfolio/{portfolioId}": {
      "schema": "Portfolio",
      "description": "Published portfolio content (public read, admin write)"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account data"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Project enquiries submitted by visitors"
    },
    "/admins/{adminId}": {
      "schema": "UserProfile",
      "description": "Designated administrator records"
    }
  }
}
